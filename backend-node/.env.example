# Copy to backend-node/.env and fill in. Without GNOSIA_DATABASE_URL the backend uses an embedded
# PostgreSQL (PGlite) stored in backend-node/data, so development needs no database server.
# postgresql://, postgres:// and the old postgresql+psycopg:// forms are all accepted.
GNOSIA_DATABASE_URL=postgresql://gnosia:CHANGE_ME@localhost:5432/gnosia
GNOSIA_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Set to true when served over HTTPS
GNOSIA_COOKIE_SECURE=false
# Password of the demo accounts created by the seed (default: gnosia123). Set your own on a public deployment.
GNOSIA_DEMO_PASSWORD=
