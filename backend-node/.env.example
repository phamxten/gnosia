# Copy to backend-node/.env and fill in.
# Opsi 1 — satu URL koneksi MySQL:
GNOSIA_DATABASE_URL=mysql://gnosia:CHANGE_ME@127.0.0.1:3306/gnosia

# Opsi 2 — variabel terpisah (praktis untuk Hostinger hPanel agar karakter spesial di password aman):
# GNOSIA_DB_HOST=127.0.0.1
# GNOSIA_DB_PORT=3306
# GNOSIA_DB_NAME=u123456789_gnosia
# GNOSIA_DB_USER=u123456789_admin
# GNOSIA_DB_PASSWORD=CHANGE_ME

GNOSIA_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Set to true when served over HTTPS (Hostinger production)
GNOSIA_COOKIE_SECURE=false
# Password of the demo/initial accounts created by the seed (default: gnosia123). Set your own on a public deployment!
GNOSIA_DEMO_PASSWORD=
